  "author": "Concept Transpiler Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.0.0",
    "commander": "^9.0.0",
    "peggy": "^5.0.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "eslint": "^8.0.0",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
