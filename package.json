{
  "name": "concept-transpiler",
  "version": "1.0.0",
  "description": "A transpiler for converting Concept 4GL language to JavaScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node cli.js",
    "test": "node test-peggy.js",
    "build": "vite build",
    "dev": "node --inspect cli.js",
    "web:dev": "vite",
    "web:build": "vite build",
  "vercel-build": "npm run test && npm run build"
  },
  "keywords": [
    "concept",
    "4gl",
    "transpiler",
    "javascript",
    "visma",
    "enterprise"
